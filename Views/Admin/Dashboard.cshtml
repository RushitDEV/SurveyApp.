@model SurveyApp.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Paneli";
}

<div class="container-fluid p-0 bg-light min-vh-100">
    <!-- Header -->
    <div class="bg-gradient text-white py-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0 fw-bold">
                        <i class="bi bi-speedometer2 me-2"></i>Admin Paneli
                    </h2>
                    <p class="mb-0 opacity-75">Sistem geneli yönetim ve istatistikler</p>
                </div>
                <!-- SignalR durum -->
                <div id="connectionStatus" class="badge bg-danger">
                    <i class="bi bi-wifi-off me-1"></i>Bağlantı bekleniyor...
                </div>
            </div>
        </div>
    </div>

    <!-- Bildirim Alanı -->
    <div class="container mt-3">
        <div id="notificationArea"></div>
    </div>

    <div class="container py-5">
        <!-- İstatistik Kartları (mevcut kodunuz) -->
        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center p-4">
                        <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex p-3 mb-3">
                            <i class="bi bi-people fs-1 text-primary"></i>
                        </div>
                        <h3 class="fw-bold mb-1">@Model.TotalUsers</h3>
                        <p class="text-muted mb-0">Toplam Kullanıcı</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center p-4">
                        <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex p-3 mb-3">
                            <i class="bi bi-clipboard-data fs-1 text-success"></i>
                        </div>
                        <h3 class="fw-bold mb-1">@Model.TotalSurveys</h3>
                        <p class="text-muted mb-0">Toplam Anket</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center p-4">
                        <div class="rounded-circle bg-info bg-opacity-10 d-inline-flex p-3 mb-3">
                            <i class="bi bi-check-circle fs-1 text-info"></i>
                        </div>
                        <h3 class="fw-bold mb-1">@Model.ActiveSurveys</h3>
                        <p class="text-muted mb-0">Aktif Anket</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center p-4">
                        <div class="rounded-circle bg-warning bg-opacity-10 d-inline-flex p-3 mb-3">
                            <i class="bi bi-chat-left-text fs-1 text-warning"></i>
                        </div>
                        <h3 class="fw-bold mb-1" id="totalResponses">@Model.TotalResponses</h3>
                        <p class="text-muted mb-0">Toplam Yanıt</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Diğer içerik (Son Anketler vb.) buraya gelecek -->
    </div>
</div>

<!-- ✅ SignalR Client Library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<script>
    // SignalR bağlantısı
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/surveyHub")
        .withAutomaticReconnect()
        .configureLogging(signalR.LogLevel.Information)
        .build();

    // Bağlantı durumu göstergesi
    const statusBadge = document.getElementById('connectionStatus');

    function updateConnectionStatus(status, message) {
        statusBadge.className = `badge bg-${status}`;
        statusBadge.innerHTML = message;
    }

    // Bağlantı başarılı
    connection.start()
        .then(() => {
            console.log('✅ SignalR bağlantısı başarılı!');
            updateConnectionStatus('success', '<i class="bi bi-wifi me-1"></i>Canlı');
        })
        .catch(err => {
            console.error('❌ SignalR bağlantı hatası:', err);
            updateConnectionStatus('danger', '<i class="bi bi-wifi-off me-1"></i>Bağlantı hatası');
        });

    // Yeniden bağlanma olayları
    connection.onreconnecting(() => {
        updateConnectionStatus('warning', '<i class="bi bi-arrow-clockwise me-1"></i>Yeniden bağlanıyor...');
    });

    connection.onreconnected(() => {
        updateConnectionStatus('success', '<i class="bi bi-wifi me-1"></i>Canlı');
        showNotification('success', 'Bağlantı yeniden sağlandı');
    });

    connection.onclose(() => {
        updateConnectionStatus('danger', '<i class="bi bi-wifi-off me-1"></i>Bağlantı kesildi');
        showNotification('danger', 'SignalR bağlantısı kesildi');
    });

    // ✅ Yeni yanıt bildirimi al
    connection.on("ReceiveNewResponse", function (data) {
        console.log('📩 Yeni yanıt bildirimi:', data);

        // İstatistiği güncelle
        const totalResponsesEl = document.getElementById('totalResponses');
        if (totalResponsesEl) {
            totalResponsesEl.textContent = parseInt(totalResponsesEl.textContent) + 1;

            // Animasyon
            totalResponsesEl.classList.add('text-success');
            setTimeout(() => totalResponsesEl.classList.remove('text-success'), 1000);
        }

        // Bildirim göster
        showNotification('info', `
            <strong>${data.surveyTitle}</strong> anketine yeni yanıt geldi!<br>
            <small>Toplam ${data.responseCount} yanıt</small>
        `);

        // Toast bildirimi
        showToast('Yeni Yanıt!', `${data.surveyTitle} - ${data.responseCount} yanıt`);
    });

    // Bildirim gösterme fonksiyonu
    function showNotification(type, message) {
        const notificationArea = document.getElementById('notificationArea');
        const alert = document.createElement('div');
        alert.className = `alert alert-${type} alert-dismissible fade show`;
        alert.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        notificationArea.appendChild(alert);

        // 5 saniye sonra otomatik kaldır
        setTimeout(() => {
            alert.classList.remove('show');
            setTimeout(() => alert.remove(), 150);
        }, 5000);
    }

    // Toast bildirimi
    function showToast(title, message) {
        // Bootstrap Toast varsa kullan
        const toastHtml = `
            <div class="toast-container position-fixed bottom-0 end-0 p-3">
                <div class="toast" role="alert">
                    <div class="toast-header bg-primary text-white">
                        <i class="bi bi-bell-fill me-2"></i>
                        <strong class="me-auto">${title}</strong>
                        <small>Az önce</small>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                    </div>
                    <div class="toast-body">
                        ${message}
                    </div>
                </div>
            </div>
        `;

        document.body.insertAdjacentHTML('beforeend', toastHtml);
        const toastEl = document.querySelector('.toast:last-child');
        const toast = new bootstrap.Toast(toastEl);
        toast.show();

        // Toast kapandıktan sonra DOM'dan kaldır
        toastEl.addEventListener('hidden.bs.toast', () => toastEl.parentElement.remove());
    }
</script>

<style>
    @@keyframes pulse {
        0%, 100%

    {
        transform: scale(1);
    }

    50% {
        transform: scale(1.1);
    }

    }

    .text-success {
        animation: pulse 0.5s ease-in-out;
    }

    #connectionStatus {
        font-size: 0.875rem;
        padding: 0.5rem 1rem;
    }

    .toast {
        min-width: 300px;
    }
</style>