@model IEnumerable<SurveyApp.ViewModels.SurveyListViewModel>
@{
    ViewData["Title"] = "Tüm Anketler - Admin";
}

<div class="container-fluid p-0 bg-light min-vh-100">
    <!-- Header -->
    <div class="bg-white border-bottom">
        <div class="container py-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <a asp-action="Dashboard" class="btn btn-light me-2">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <span class="fw-bold fs-4">Tüm Anketler</span>
                </div>
                <span class="badge bg-primary fs-6">@Model.Count() Anket</span>
            </div>
        </div>
    </div>

    <div class="container py-4">
        @if (Model.Any())
        {
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Başlık</th>
                                    <th>Oluşturan</th>
                                    <th>Oluşturulma</th>
                                    <th class="text-center">Sorular</th>
                                    <th class="text-center">Yanıtlar</th>
                                    <th class="text-center">Durum</th>
                                    <th class="text-center">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var survey in Model)
                                {
                                    <tr>
                                        <td class="fw-bold">#@survey.Id</td>
                                        <td>
                                            <div class="fw-bold">@survey.Title</div>
                                            <small class="text-muted">
                                                @(survey.Description?.Length > 50 ? survey.Description.Substring(0, 50) + "..." : survey.Description)
                                            </small>
                                        </td>
                                        <td>
                                            <div class="fw-bold">@survey.Title</div>
                                            <small class="text-muted">@survey.CreatedBy</small>
                                        </td>

                                        <td>
                                            <small class="text-muted">
                                                <i class="bi bi-calendar me-1"></i>
                                                @survey.CreatedDate.ToString("dd MMM yyyy HH:mm")
                                            </small>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark">@survey.QuestionCount</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-primary">@survey.ResponseCount</span>
                                        </td>
                                        <td class="text-center">
                                            @if (survey.IsActive)
                                            {
                                                <span class="badge bg-success">Aktif</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Pasif</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <a asp-action="SurveyDetails" asp-route-id="@survey.Id"
                                                   class="btn btn-outline-primary" title="Detaylar">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <button class="btn btn-outline-danger"
                                                        onclick="deleteSurvey(@survey.Id)" title="Sil">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
                    <h4 class="mt-4 text-muted">Henüz anket oluşturulmamış</h4>
                    <p class="text-muted">Kullanıcılar anket oluşturdukça burada görünecek</p>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function deleteSurvey(id) {
        if (confirm('Bu anketi ve tüm verilerini silmek istediğinizden emin misiniz?')) {
            fetch('/Admin/DeleteSurvey/' + id, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    alert('✅ ' + data.message);
                    location.reload();
                } else {
                    alert('❌ ' + data.message);
                }
            })
            .catch(e => alert('❌ Bir hata oluştu: ' + e));
        }
    }
</script>

<style>
    .table tbody tr {
        transition: background-color 0.2s;
    }

        .table tbody tr:hover {
            background-color: rgba(0,0,0,0.02);
        }

    .btn-group-sm .btn {
        padding: 0.25rem 0.5rem;
    }
</style>