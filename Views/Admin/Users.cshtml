@model IEnumerable<SurveyApp.Models.User>
@{
    ViewData["Title"] = "Kullanıcılar - Admin";
}

<div class="container-fluid p-0 bg-light min-vh-100">
    <!-- Header -->
    <div class="bg-white border-bottom">
        <div class="container py-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <a asp-action="Dashboard" class="btn btn-light me-2">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <span class="fw-bold fs-4">Kullanıcılar</span>
                </div>
                <span class="badge bg-primary fs-6">@Model.Count() Kullanıcı</span>
            </div>
        </div>
    </div>

    <div class="container py-4">
        @if (Model.Any())
        {
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Kullanıcı Adı</th>
                                    <th>E-posta</th>
                                    <th>Kayıt Tarihi</th>
                                    <th class="text-center">Anketleri</th>
                                    <th class="text-center">Yanıtları</th>
                                    <th class="text-center">Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model)
                                {
                                    <tr>
                                        <td class="fw-bold">#@user.Id</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-person-circle fs-4 text-primary me-2"></i>
                                                <div>
                                                    <div class="fw-bold">@user.UserName</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <i class="bi bi-envelope me-1"></i>
                                            @user.Email
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                <i class="bi bi-calendar me-1"></i>
                                                @user.CreatedAt.ToString("dd MMM yyyy HH:mm")
                                            </small>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark">@user.Surveys.Count</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-primary">@user.Responses.Count</span>
                                        </td>
                                        <td class="text-center">
                                            @if (user.IsActive)
                                            {
                                                <span class="badge bg-success" id="status_@user.Id">Aktif</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger" id="status_@user.Id">Pasif</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- İstatistikler -->
            <div class="row g-4 mt-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <i class="bi bi-people-fill fs-1 text-primary mb-2"></i>
                            <h3 class="fw-bold mb-0">@Model.Count()</h3>
                            <small class="text-muted">Toplam Kullanıcı</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <i class="bi bi-check-circle-fill fs-1 text-success mb-2"></i>
                            <h3 class="fw-bold mb-0">@Model.Count(u => u.IsActive)</h3>
                            <small class="text-muted">Aktif Kullanıcı</small>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-person-x text-muted" style="font-size: 4rem;"></i>
                    <h4 class="mt-4 text-muted">Henüz kullanıcı yok</h4>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .table tbody tr {
        transition: background-color 0.2s;
    }

        .table tbody tr:hover {
            background-color: rgba(0,0,0,0.02);
        }
</style>